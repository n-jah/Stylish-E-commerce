<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cart_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_card"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">



    <!-- Product Image -->
    <LinearLayout
        android:id="@+id/productImageframe"
        android:layout_width="80dp"
        android:layout_height="100dp"
        android:layout_marginEnd="16dp"

        android:background="@drawable/bg_image_rounded"
        android:padding="3dp">

        <ImageView

            android:id="@+id/productImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/hoodie_image1" />


    </LinearLayout>


    <!-- Product Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Product Name -->
        <TextView
            android:id="@+id/productName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Men's Tie-Dye T-Shirt Nike Sportswear"
            android:textAppearance="@style/men_s_tie_d"
            android:lineSpacingExtra="2sp"
            android:maxLines="2"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <!-- Product Price and Tax -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$"
                android:textColor="@color/secondrey_text_color_light"
                android:lineSpacingExtra="-1sp"
                />

            <!-- Product   Tax -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/productPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="-1sp"
                    android:text="99"
                    android:textColor="@color/secondrey_text_color_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(+$"
                    android:gravity="top"
                    android:textColor="@color/secondrey_text_color_light"
                    android:lineSpacingExtra="-1sp"
                    />      <TextView
                android:id="@+id/producTaxes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tax"
                android:textColor="@color/secondrey_text_color_light"
                android:lineSpacingExtra="-1sp"
                />      <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Tax)"
                android:textColor="@color/secondrey_text_color_light"
                android:lineSpacingExtra="-1sp"
                />

            </LinearLayout>

        </LinearLayout>


        <!-- Quantity Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:layout_gravity="bottom"
            android:layout_marginTop="15dp"

            >

            <!-- Decrease Quantity Button -->

            <!-- Quantity Text -->

            <ImageButton
                android:id="@+id/btnDecrease"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_outline"
                android:contentDescription="@string/decrease_quantity"
                android:scaleType="centerInside"
                android:scaleX=".8"
                android:scaleY=".8"
                android:src="@drawable/baseline_keyboard_arrow_down_24" />

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="8dp"
                android:text="1"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Increase Quantity Button -->
            <ImageButton
                android:id="@+id/btnIncrease"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_outline"
                android:contentDescription="@string/decrease_quantity"
                android:src="@drawable/baseline_keyboard_arrow_up_24"
                android:scaleType="centerInside"
                android:scaleX=".8"
                android:scaleY=".8"
                />

        </LinearLayout>



    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/circle_outline"
        android:scaleType="centerInside"
        android:src="@drawable/baseline_delete_outline_24"
        android:scaleX=".8"
        android:scaleY=".8"
        android:layout_gravity="end|bottom"
        />


    <!-- Delete Button -->

</LinearLayout>
