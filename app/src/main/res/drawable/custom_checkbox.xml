<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State when checkbox is checked -->
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="#4CAF50" /> <!-- Green color -->
            <size android:width="24dp" android:height="24dp" /> <!-- Adjust the size as needed -->
        </shape>
    </item>

    <!-- State when checkbox is unchecked -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" /> <!-- White background color -->
            <stroke android:width="2dp" android:color="#4CAF50" /> <!-- Green border -->
            <size android:width="24dp" android:height="24dp" /> <!-- Adjust the size as needed -->
        </shape>
    </item>
</selector>
